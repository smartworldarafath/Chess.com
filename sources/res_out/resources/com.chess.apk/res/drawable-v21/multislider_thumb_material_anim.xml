<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape
            android:tint="?android:attr/colorControlNormal"
            android:shape="ring"
            android:useLevel="false"
            android:insetLeft="3dp"
            android:insetRight="3dp"
            android:innerRadius="2dp"
            android:thickness="2dp">
            <solid android:color="@color/white"/>
            <size
                android:height="18dp"
                android:width="18dp"/>
        </shape>
    </item>
    <item
        android:state_pressed="true"
        android:id="@+id/pressed"
        android:drawable="@drawable/multislider_thumb_pressed_to_unpressed"/>
    <item
        android:id="@+id/unpressed"
        android:drawable="@drawable/multislider_thumb_unpressed_to_pressed"/>
    <transition
        android:drawable="@drawable/multislider_thumb_unpressed_to_pressed_animation"
        android:toId="@+id/pressed"
        android:fromId="@+id/unpressed"/>
    <transition
        android:drawable="@drawable/multislider_thumb_pressed_to_unpressed_animation"
        android:toId="@+id/unpressed"
        android:fromId="@+id/pressed"/>
</animated-selector>
