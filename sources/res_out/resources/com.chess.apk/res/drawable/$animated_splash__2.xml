<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <objectAnimator
        android:duration="@integer/splashAnimationDuration"
        android:valueFrom="5"
        android:valueTo="0"
        android:propertyName="translateX"/>
    <objectAnimator
        android:duration="@integer/splashAnimationDuration"
        android:valueFrom="3"
        android:valueTo="1"
        android:propertyName="scaleX"/>
    <objectAnimator
        android:duration="@integer/splashAnimationDuration"
        android:valueFrom="3"
        android:valueTo="1"
        android:propertyName="scaleY"/>
</set>
