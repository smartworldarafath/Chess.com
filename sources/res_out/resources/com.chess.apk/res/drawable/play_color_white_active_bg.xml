<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="3dp"
                android:color="@color/win"/>
            <corners android:radius="@dimen/radius_play_color_switcher_stroke"/>
        </shape>
    </item>
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">
        <ripple android:color="@color/black_20">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/white"/>
                    <corners android:radius="@dimen/radius_play_color_switcher"/>
                </shape>
            </item>
        </ripple>
    </item>
</layer-list>
