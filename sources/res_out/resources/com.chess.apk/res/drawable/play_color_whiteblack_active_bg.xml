<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="3dp"
                android:color="@color/win"/>
            <corners android:radius="@dimen/radius_play_color_switcher_stroke"/>
        </shape>
    </item>
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">
        <ripple android:color="@color/grey_40">
            <item>
                <rotate android:fromDegrees="90">
                    <shape android:shape="rectangle">
                        <gradient
                            android:startColor="@color/white"
                            android:endColor="@color/black"
                            android:angle="0"
                            android:type="sweep"
                            android:centerX="-1000"
                            android:centerY="0.5"
                            android:gradientRadius="100"/>
                        <corners android:radius="@dimen/radius_play_color_switcher"/>
                    </shape>
                </rotate>
            </item>
        </ripple>
    </item>
</layer-list>
