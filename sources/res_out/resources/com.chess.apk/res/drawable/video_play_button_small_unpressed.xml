<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent"/>
            <size
                android:height="@dimen/video_play_button_size_small"
                android:width="@dimen/video_play_button_size_small"/>
            <stroke
                android:width="1dp"
                android:color="@color/video_play_shadow_unpressed"/>
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="oval">
            <solid android:color="@color/video_play_border_unpressed"/>
            <size
                android:height="@dimen/video_play_button_size_small"
                android:width="@dimen/video_play_button_size_small"/>
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/video_play_ring_unpressed"/>
        </shape>
    </item>
</layer-list>
