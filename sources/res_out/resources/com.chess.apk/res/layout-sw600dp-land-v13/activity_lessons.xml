<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.chess.utils.android.toolbar.CenteredToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/home_recyclerview_horizontal_padding">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="@dimen/lesson_land_divider_guideline_percent"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/rankSideColumn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lesson_learning_rank_top_margin"
            android:fillViewport="true"
            android:layout_marginEnd="@dimen/half_margin_standard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guideline"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.chess.internal.views.LearningRankView
                    android:id="@+id/rankView"
                    android:background="@drawable/black_rounded_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/scrollContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/guideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.chess.internal.recyclerview.AutoColumnRecyclerView
                android:id="@+id/recyclerView"
                android:paddingTop="@dimen/home_recyclerview_top_padding"
                android:paddingBottom="@dimen/home_recyclerview_bottom_padding"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingEnd="@dimen/home_recyclerview_horizontal_padding"
                app:enforceTwinSpanCount="true"
                app:minColumnCount="4"/>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/snackBarContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ProgressBar
            android:id="@+id/loadingView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:layout_constraintBottom_toBottomOf="@+id/scrollContainer"
            app:layout_constraintEnd_toEndOf="@+id/scrollContainer"
            app:layout_constraintStart_toStartOf="@+id/scrollContainer"
            app:layout_constraintTop_toTopOf="@+id/scrollContainer"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
