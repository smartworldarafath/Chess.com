<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="@dimen/recent_row_height">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white_40"
        android:gravity="center"
        android:id="@+id/idTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="50dp"
        android:singleLine="true"
        android:layout_marginStart="@dimen/first_keyline"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ratingTxt"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Medium"/>
    <TextView
        android:textSize="14sp"
        android:gravity="center"
        android:id="@+id/ratingTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="36dp"
        android:singleLine="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/idTxt"
        app:layout_constraintEnd_toStartOf="@+id/themeTxt"
        app:layout_constraintStart_toEndOf="@+id/idTxt"
        style="@style/Medium"/>
    <TextView
        android:textSize="14sp"
        android:id="@+id/themeTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/recent_learning_theme_min_width"
        android:singleLine="true"
        android:textDirection="locale"
        android:textAlignment="viewStart"
        android:paddingEnd="@dimen/margin_small"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/idTxt"
        app:layout_constraintEnd_toStartOf="@+id/outcomeBackgroundHelper"
        app:layout_constraintStart_toEndOf="@+id/ratingTxt"
        style="@style/Medium"/>
    <View
        android:id="@+id/outcomeBackgroundHelper"
        android:layout_width="1dp"
        android:layout_height="40dp"
        android:layout_marginEnd="@dimen/first_keyline"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/crown1Img"
        app:layout_constraintStart_toEndOf="@+id/themeTxt"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/outcomeBackground"
        android:background="@color/black_20"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/outcomeBackgroundHelper"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/crown3Img"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="@dimen/first_keyline"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/glyph_game_crown_3"/>
    <ImageView
        android:id="@+id/crown2Img"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/crown3Img"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/glyph_game_crown_3"/>
    <ImageView
        android:id="@+id/crown1Img"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/crown2Img"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/glyph_game_crown_3"/>
    <Space
        android:id="@+id/divider0Space"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ratingTxt"
        app:layout_constraintStart_toEndOf="@+id/idTxt"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/divider1Space"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/themeTxt"
        app:layout_constraintStart_toEndOf="@+id/ratingTxt"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/divider2Space"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/outcomeBackground"
        app:layout_constraintStart_toEndOf="@+id/themeTxt"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white_65"
        android:gravity="center"
        android:id="@+id/idLabelTxt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/id"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/idTxt"
        app:layout_constraintStart_toStartOf="@+id/idTxt"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Medium"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white_65"
        android:gravity="center"
        android:id="@+id/ratingLabelTxt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/rated_rating"
        android:singleLine="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/idLabelTxt"
        app:layout_constraintEnd_toStartOf="@+id/divider1Space"
        app:layout_constraintStart_toStartOf="@+id/divider0Space"
        style="@style/Medium"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white_65"
        android:id="@+id/themeLabelTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/recent_learning_theme_min_width"
        android:text="@string/theme"
        android:singleLine="true"
        android:textDirection="locale"
        android:textAlignment="viewStart"
        android:paddingEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/idLabelTxt"
        app:layout_constraintEnd_toStartOf="@+id/divider2Space"
        app:layout_constraintStart_toEndOf="@+id/divider1Space"
        style="@style/Medium"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/white_65"
        android:gravity="center"
        android:id="@+id/outcomeLabelTxt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/outcome"
        android:singleLine="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/idLabelTxt"
        app:layout_constraintEnd_toEndOf="@+id/outcomeBackground"
        app:layout_constraintStart_toStartOf="@+id/outcomeBackground"
        style="@style/Medium"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/labelsGroup"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="idLabelTxt, ratingLabelTxt, themeLabelTxt, outcomeLabelTxt"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/valuesGroup"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="idTxt, ratingTxt, themeTxt, crown1Img, crown2Img, crown3Img"/>
</androidx.constraintlayout.widget.ConstraintLayout>
