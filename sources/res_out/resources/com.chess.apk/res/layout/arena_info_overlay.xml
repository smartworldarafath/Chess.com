<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black_80"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="36sp"
        android:textColor="@color/white"
        android:id="@+id/overlayHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/arena"
        app:layout_constraintBottom_toTopOf="@+id/overlayBody"
        app:layout_constraintEnd_toEndOf="@+id/overlayBody"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/overlayBody"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="36sp"
        android:textColor="@color/white_text"
        android:id="@+id/overlayClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/ic_close"
        android:fontFamily="@font/custom_icon"
        android:textAlignment="center"
        android:layout_marginEnd="@dimen/arena_overlay_x_end_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="24sp"
        android:textColor="@color/white"
        android:id="@+id/overlayBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/arena_overlay_margin_vertical"
        android:layout_marginBottom="@dimen/arena_overlay_margin_vertical"
        android:text="@string/play_as_many"
        android:layout_marginStart="@dimen/arena_overlay_margin_horizontal"
        android:layout_marginEnd="@dimen/arena_overlay_margin_horizontal"
        app:layout_constraintBottom_toTopOf="@+id/overlayMoreInfo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/overlayHeading"/>
    <TextView
        android:textSize="24sp"
        android:textColor="@color/tournaments_overlay_blue"
        android:id="@+id/overlayMoreInfo"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/more_info"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/overlayBody"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/overlayBody"
        app:layout_constraintTop_toBottomOf="@+id/overlayBody"/>
</androidx.constraintlayout.widget.ConstraintLayout>
