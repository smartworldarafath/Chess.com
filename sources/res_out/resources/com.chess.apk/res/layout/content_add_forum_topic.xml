<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:textColor="@color/white_72"
            android:textColorHint="@color/white_50"
            android:id="@+id/forumTopicNameEdt"
            android:background="@drawable/black_rounded_bg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/topic_name"
            android:imeOptions="actionDone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TextInput"/>
        <com.chess.internal.views.TypedSpinner
            android:layout_gravity="center"
            android:id="@+id/forumCategoriesSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_standard"
            android:layout_marginStart="@dimen/margin_standard"
            android:layout_marginEnd="@dimen/margin_standard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/forumTopicNameEdt"
            app:layout_constraintWidth_max="@dimen/content_max_width"/>
        <EditText
            android:textColor="@color/white_72"
            android:textColorHint="@color/white_50"
            android:id="@+id/forumTopicBodyEdt"
            android:background="@drawable/black_rounded_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/write_post"
            android:imeOptions="actionDone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/forumCategoriesSpinner"
            style="@style/TextArea"/>
        <com.chess.internal.views.RaisedButton
            android:id="@+id/createNewFormTopicBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_standard"
            android:text="@string/create_new_topic"
            android:layout_marginStart="@dimen/margin_standard"
            android:layout_marginEnd="@dimen/margin_standard"
            app:cardBackgroundColor="@color/accent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/forumTopicBodyEdt"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
