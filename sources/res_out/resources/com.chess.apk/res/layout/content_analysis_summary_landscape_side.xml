<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/analysisSummarySide"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/colorToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.chess.internal.views.EvaluationBarView
            android:id="@+id/analysis_evaluation_bar"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.chess.internal.views.MoveDetailsView
            android:id="@+id/moveDetailsView1"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="@dimen/margin_x_small"
            android:layout_marginBottom="@dimen/margin_xx_small"/>
        <com.chess.internal.views.MoveDetailsView
            android:id="@+id/moveDetailsView2"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="@dimen/margin_xx_small"
            android:layout_marginBottom="@dimen/margin_x_small"/>
        <com.chess.features.analysis.views.ThinkPathView
            android:id="@+id/thinkingPathView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="@dimen/margin_x_small"
            android:layout_marginBottom="@dimen/margin_xx_small"
            android:paddingEnd="@dimen/margin_x_small"/>
        <com.chess.features.analysis.views.ThinkPathView
            android:id="@+id/thinkingPathView2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="@dimen/margin_xx_small"
            android:layout_marginBottom="@dimen/margin_x_small"
            android:paddingEnd="@dimen/margin_x_small"/>
    </LinearLayout>
    <ScrollView
        android:scrollbarStyle="outsideOverlay"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/cbl_container_landscape_vertical_margin"
        android:layout_marginBottom="@dimen/margin_small">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white_65"
                android:id="@+id/opening_data"
                android:background="@color/black_40"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?android:attr/selectableItemBackground"
                android:fontFamily="@font/custom_regular"
                android:paddingHorizontal="@dimen/margin_standard"
                android:paddingVertical="@dimen/margin_small"/>
            <com.chess.analysis.views.board.CBTreeHistoryViewAnalysis
                android:id="@+id/moveListTxt"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CBTreeHistory"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
