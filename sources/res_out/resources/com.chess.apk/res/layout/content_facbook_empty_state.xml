<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/emptyStateImg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_large"
            android:layout_marginBottom="24dp"
            android:src="@drawable/color_magnifier_sad"
            android:contentDescription="@string/image"
            app:layout_constraintBottom_toTopOf="@+id/emptyStateText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textColor="@color/white_65"
            android:id="@+id/emptyStateText"
            android:paddingTop="@dimen/margin_large"
            android:paddingBottom="@dimen/margin_x_large"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_facebook_friends_found"
            app:layout_constraintBottom_toTopOf="@+id/inviteToJoinText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/emptyStateImg"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/Bold.ChessSans"/>
        <TextView
            android:textColor="@color/white_65"
            android:gravity="center"
            android:id="@+id/inviteToJoinText"
            android:paddingBottom="@dimen/margin_large"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/invite_friends_to_join"
            app:layout_constraintBottom_toTopOf="@+id/emptyStateBtn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/emptyStateText"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/Bold.ChessSans"/>
        <com.chess.internal.views.RaisedButton
            android:id="@+id/emptyStateBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/invite_friends"
            android:layout_marginStart="@dimen/empty_state_button_margin_side"
            android:layout_marginEnd="@dimen/empty_state_button_margin_side"
            app:cardBackgroundColor="@color/facebook"
            app:layout_constraintBottom_toTopOf="@+id/remindReconnectText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/inviteToJoinText"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintWidth_max="@dimen/content_max_width"/>
        <TextView
            android:textColor="@color/white_65"
            android:gravity="center"
            android:id="@+id/remindReconnectText"
            android:paddingTop="@dimen/margin_standard"
            android:paddingBottom="@dimen/margin_large"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/or_remind_them_to_connect"
            android:layout_marginStart="@dimen/empty_state_button_margin_side"
            android:layout_marginEnd="@dimen/empty_state_button_margin_side"
            app:layout_constraintBottom_toTopOf="@+id/linkText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/emptyStateBtn"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/Bold.ChessSans"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white_80"
            android:gravity="center"
            android:id="@+id/linkText"
            android:background="@drawable/link_background_2"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_large"
            android:textIsSelectable="true"
            android:paddingStart="@dimen/margin_standard"
            android:paddingEnd="@dimen/margin_standard"
            android:layout_marginStart="@dimen/empty_state_copy_link_margin_side"
            android:layout_marginEnd="@dimen/empty_state_copy_link_margin_side"
            android:focusedByDefault="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/remindReconnectText"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/TextViewStyle.WhiteText.DialogSubtitle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
