<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:id="@+id/topViewContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <com.chess.practice.play.PracticePlayerInfoView
        android:id="@+id/compDetailsView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.chess.practice.play.PracticeEditCompLevelView
        android:id="@+id/editCompLevelView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.chess.palette.movehistory.AnalysisMoveDetailsView
        android:id="@+id/moveDetailsView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</FrameLayout>
