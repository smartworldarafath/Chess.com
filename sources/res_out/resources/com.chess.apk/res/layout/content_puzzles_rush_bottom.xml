<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/puzzlesRushBottom"
    android:layout_width="match_parent"
    android:layout_height="36dp">
    <Space
        android:id="@+id/strikesView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/strike1"
        android:padding="1dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_strike_square"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/strike2"
        android:padding="1dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_strike_square"
        android:importantForAccessibility="no"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/strike1"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/strike3"
        android:padding="1dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_strike_square"
        android:importantForAccessibility="no"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/strike2"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/difficultyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/difficulty"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TinyText"/>
    <TextView
        android:id="@+id/difficultyValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/SmallText_BoldWeight"/>
</androidx.constraintlayout.widget.ConstraintLayout>
