<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <com.chess.features.playerstatus.views.PlayerStatusView
        android:id="@+id/topPlayerStatusView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/game_move_history_view_height"
        android:paddingHorizontal="@dimen/margin_large"
        app:layout_constraintBottom_toTopOf="@+id/chessBoardPreview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.chess.palette.components.ComposeView
        android:id="@+id/chessBoardPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/welcome_chessboard_content_description"
        app:layout_constraintBottom_toTopOf="@+id/bottomPlayerStatusView"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topPlayerStatusView"/>
    <com.chess.features.playerstatus.views.PlayerStatusView
        android:id="@+id/bottomPlayerStatusView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/margin_large"
        app:layout_constraintBottom_toTopOf="@+id/controlsViewContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chessBoardPreview"/>
    <include
        android:id="@+id/waitPopup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/chessBoardPreview"
        app:layout_constraintEnd_toEndOf="@+id/chessBoardPreview"
        app:layout_constraintStart_toStartOf="@+id/chessBoardPreview"
        app:layout_constraintTop_toTopOf="@+id/chessBoardPreview"
        layout="@layout/wait_popup"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controlsViewContainer"
        android:background="@color/black_20"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.chess.realchess.ui.wait.WaitGameControlView
            android:id="@+id/controlsView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_max="@dimen/bottom_button_max_width"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
