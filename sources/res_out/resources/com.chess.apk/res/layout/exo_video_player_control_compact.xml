<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <View
        android:id="@+id/exo_controls_background"
        android:background="#66000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/exo_center_controls"
        android:background="@null"
        android:padding="4dp"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/exo_rew"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/exo_styled_controls_rewind"
            android:scaleType="fitCenter"
            android:contentDescription="@string/exo_controls_rewind_description"/>
        <ImageButton
            android:id="@+id/exo_play_pause"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/exo_styled_controls_play"
            android:scaleType="fitCenter"
            android:contentDescription="@string/exo_controls_play_description"
            android:layout_marginHorizontal="8dp"/>
        <ImageButton
            android:id="@+id/exo_ffwd"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/exo_styled_controls_fastforward"
            android:scaleType="fitCenter"
            android:contentDescription="@string/exo_controls_fastforward_description"/>
    </LinearLayout>
    <androidx.media3.ui.DefaultTimeBar
        android:layout_gravity="bottom"
        android:id="@+id/exo_progress"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginBottom="32dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/exo_bottom_bar"
        android:background="#66000000"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:paddingHorizontal="8dp">
        <TextView
            android:textSize="12sp"
            android:textColor="#ffbebebe"
            android:id="@+id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ffbebebe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" / "
            android:paddingHorizontal="4dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ffbebebe"
            android:id="@+id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ImageButton
            android:id="@+id/exo_settings"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/exo_styled_controls_settings"
            android:scaleType="fitCenter"
            android:contentDescription="@string/exo_controls_settings_description"/>
    </LinearLayout>
</merge>
