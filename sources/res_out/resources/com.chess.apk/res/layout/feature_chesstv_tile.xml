<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/margin_small">
    <Space
        android:id="@+id/widthSpace"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/margin_standard"
        android:layout_marginEnd="@dimen/margin_standard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/frame"
        android:duplicateParentState="true"
        android:clipChildren="false"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginTop="@dimen/margin_small"
        app:cardBackgroundColor="@color/white_10"
        app:cardCornerRadius="@dimen/radius_medium"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:contentPadding="@dimen/margin_x_small"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="@+id/widthSpace"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/showImg"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:scaleType="fitCenter"
                android:layout_weight="1"/>
            <TextView
                android:textSize="@dimen/home_screen_tile_title_text_size"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/liveBanner"
                android:background="@drawable/red_bottom_rounded"
                android:padding="@dimen/margin_x_small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/live"
                android:textAllCaps="true"
                style="@style/Bold"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/home_screen_tile_title_text_size"
        android:ellipsize="end"
        android:id="@+id/titleTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="5"
        android:textDirection="locale"
        android:textAlignment="viewStart"
        android:layout_marginHorizontal="@dimen/margin_standard"
        android:layout_marginVertical="@dimen/margin_xx_standard"
        app:layout_constraintEnd_toEndOf="@+id/widthSpace"
        app:layout_constraintStart_toEndOf="@+id/frame"
        app:layout_constraintTop_toTopOf="@+id/frame"
        style="@style/Bold.ChessSans"/>
    <ImageView
        android:id="@+id/close_button"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/close"
        android:layout_marginEnd="@dimen/first_keyline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/glyph_circle_fill_cross"
        app:tint="@color/white_65"/>
</androidx.constraintlayout.widget.ConstraintLayout>
