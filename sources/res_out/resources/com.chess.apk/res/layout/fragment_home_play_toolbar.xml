<?xml version="1.0" encoding="utf-8"?>
<com.google.inputmethod.material.appbar.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:stateListAnimator="@null">
    <include
        android:id="@+id/toolbar_play_logged_in"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/view_play_toolbar_logged_in"/>
    <include
        android:id="@+id/toolbar_play_logged_out"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/view_play_toolbar_logged_out"/>
</com.google.inputmethod.material.appbar.AppBarLayout>
