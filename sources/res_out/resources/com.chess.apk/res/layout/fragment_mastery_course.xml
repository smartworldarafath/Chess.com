<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.chess.internal.recyclerview.AutoColumnRecyclerView
        android:id="@+id/recyclerView"
        android:paddingBottom="@dimen/home_recyclerview_bottom_padding"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/home_recyclerview_horizontal_padding"
        android:paddingEnd="@dimen/home_recyclerview_horizontal_padding"
        app:columnWidth="@dimen/home_tile_large_column_width"/>
    <TextView
        android:textSize="22sp"
        android:textColor="@color/white_65"
        android:layout_gravity="center"
        android:id="@+id/noResultsTxt"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_results"
        android:fontFamily="@font/custom_bold"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
