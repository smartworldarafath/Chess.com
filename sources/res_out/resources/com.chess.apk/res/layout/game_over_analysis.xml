<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/analysisLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.chess.internal.views.QuickAnalysisProgressView
        android:layout_gravity="center"
        android:id="@+id/quickAnalysisProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:progressPaddingSize="@dimen/half_margin_standard"/>
    <include
        android:layout_gravity="center"
        android:id="@+id/analysisGameOverView"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/view_analysis_game_over"/>
</androidx.constraintlayout.widget.ConstraintLayout>
