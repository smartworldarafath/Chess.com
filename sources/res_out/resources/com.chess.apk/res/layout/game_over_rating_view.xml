<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gameOverRatingLayout"
    android:paddingBottom="@dimen/half_margin_standard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/tile_text_size"
        android:textColor="@color/dialog_text_color"
        android:id="@+id/ratingTitleTxt"
        android:paddingTop="@dimen/half_margin_standard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        app:layout_constraintBottom_toTopOf="@+id/newRatingTxt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Bold"/>
    <TextView
        android:textSize="@dimen/game_over_rating_text_size"
        android:textColor="@color/black"
        android:id="@+id/newRatingTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ratingTitleTxt"
        style="@style/Bold"/>
    <TextView
        android:textSize="@dimen/game_over_rating_change_text_size"
        android:id="@+id/ratingChangeTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_standard"
        app:layout_constraintBottom_toBottomOf="@+id/newRatingTxt"
        app:layout_constraintStart_toEndOf="@+id/newRatingTxt"
        app:layout_constraintTop_toTopOf="@+id/newRatingTxt"
        style="@style/Bold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
