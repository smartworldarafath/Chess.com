<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/conditional_moves_row_height">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_move_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="48dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_vertical_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <TextView
        android:textSize="@dimen/text_size_small"
        android:textColor="@color/white_65"
        android:gravity="center"
        android:id="@+id/move_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline_move_number"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.chess.conditionalmoves.views.ConditionalMovesHistoryMoveView
        android:id="@+id/white_move"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:foreground="?attr/selectableItemBackground"
        android:layout_marginStart="32dp"
        app:layout_constraintEnd_toStartOf="@+id/guideline_vertical_center"
        app:layout_constraintStart_toEndOf="@+id/guideline_move_number"/>
    <com.chess.conditionalmoves.views.ConditionalMovesHistoryMoveView
        android:id="@+id/black_move"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guideline_vertical_center"/>
</androidx.constraintlayout.widget.ConstraintLayout>
