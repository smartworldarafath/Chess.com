<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/lesson_course_message_item_padding">
    <TextView
        android:textSize="@dimen/text_size_small"
        android:textColor="@color/white_65"
        android:gravity="center_vertical"
        android:id="@+id/itemTitleTv"
        android:padding="@dimen/margin_small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/itemDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/itemIconImg"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/localeViewStartTextStyle"/>
    <View
        android:id="@+id/itemDivider"
        android:background="@color/white_20"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="@dimen/half_margin_standard"
        app:layout_constraintBottom_toBottomOf="parent"/>
</LinearLayout>
