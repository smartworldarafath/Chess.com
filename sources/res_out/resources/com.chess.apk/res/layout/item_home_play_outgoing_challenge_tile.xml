<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/half_margin_standard"
    android:paddingBottom="@dimen/half_margin_standard"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Space
        android:id="@+id/widthSpace"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/margin_standard"
        android:layout_marginEnd="@dimen/margin_standard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width"/>
    <FrameLayout
        android:id="@+id/chessBoardFrame"
        android:background="@color/white_10"
        android:padding="@dimen/margin_x_small"
        android:duplicateParentState="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:cardBackgroundColor="@color/white_10"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="@+id/widthSpace"
        app:layout_constraintTop_toTopOf="parent">
        <com.chess.chessboard.view.ChessBoardPreview
            android:id="@+id/chessBoardView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <com.chess.internal.views.ProfileImageView
        android:id="@+id/avatar"
        android:background="@drawable/white_rounded_background"
        android:padding="2dp"
        android:layout_width="@dimen/avatar_img_list_size"
        android:layout_height="@dimen/avatar_img_list_size"
        app:layout_constraintBottom_toBottomOf="@+id/chessBoardFrame"
        app:layout_constraintEnd_toEndOf="@+id/chessBoardFrame"
        app:layout_constraintStart_toStartOf="@+id/chessBoardFrame"
        app:layout_constraintTop_toTopOf="@+id/chessBoardFrame"/>
    <TextView
        android:textSize="@dimen/home_screen_tile_title_text_size"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tileTitleTxt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_xx_standard"
        android:text="@string/outgoing_challenge"
        android:maxLines="1"
        android:textDirection="locale"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/margin_standard"
        app:layout_constraintEnd_toEndOf="@+id/widthSpace"
        app:layout_constraintStart_toEndOf="@+id/chessBoardFrame"
        app:layout_constraintTop_toTopOf="@+id/chessBoardFrame"
        style="@style/Bold.ChessSans"/>
    <TextView
        android:textSize="@dimen/text_size_small"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/usernameTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textDirection="locale"
        android:layout_marginVertical="4dp"
        app:layout_constraintStart_toStartOf="@+id/tileTitleTxt"
        app:layout_constraintTop_toBottomOf="@+id/tileTitleTxt"
        style="@style/Bold.ChessSans"/>
    <TextView
        android:textSize="@dimen/text_size_small"
        android:textColor="@color/white_65"
        android:ellipsize="end"
        android:id="@+id/ratingTxt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textDirection="locale"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/margin_x_small"
        app:layout_constraintBottom_toBottomOf="@+id/usernameTxt"
        app:layout_constraintEnd_toEndOf="@+id/widthSpace"
        app:layout_constraintStart_toEndOf="@+id/usernameTxt"
        app:layout_constraintTop_toTopOf="@+id/usernameTxt"/>
    <TextView
        android:textSize="@dimen/home_screen_tile_subtitle_text_size"
        android:gravity="start"
        android:id="@+id/tileSubtitleTxt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textDirection="locale"
        android:textAlignment="viewStart"
        android:layout_marginVertical="4dp"
        app:layout_constraintEnd_toEndOf="@+id/widthSpace"
        app:layout_constraintStart_toStartOf="@+id/tileTitleTxt"
        app:layout_constraintTop_toBottomOf="@+id/usernameTxt"
        app:layout_goneMarginStart="0dp"
        style="@style/TextViewStyle.GreyText"/>
</androidx.constraintlayout.widget.ConstraintLayout>
