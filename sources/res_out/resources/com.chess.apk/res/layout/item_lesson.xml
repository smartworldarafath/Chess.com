<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground">
    <com.chess.chessboard.view.ChessBoardPreview
        android:id="@+id/chessBoardPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.chess.internal.views.PlayOverlay
        android:id="@+id/playOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:circleBgSize="@dimen/video_play_button_size"
        app:layout_constraintBottom_toBottomOf="@+id/chessBoardPreview"
        app:layout_constraintEnd_toEndOf="@+id/chessBoardPreview"
        app:layout_constraintStart_toStartOf="@+id/chessBoardPreview"
        app:layout_constraintTop_toTopOf="@+id/chessBoardPreview"/>
    <TextView
        android:textSize="@dimen/text_size_normal"
        android:gravity="center"
        android:id="@+id/lessonTitleTxt"
        android:padding="@dimen/half_margin_standard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/custom_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chessBoardPreview"/>
</androidx.constraintlayout.widget.ConstraintLayout>
