<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.chess.internal.views.card.StyledCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_x_standard"
        android:foreground="?attr/selectableItemBackground"
        android:layout_marginStart="@dimen/margin_standard"
        android:layout_marginEnd="@dimen/margin_standard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:padding="@dimen/margin_standard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.chess.chessboard.view.ChessBoardPreview
                android:id="@+id/boardPreview"
                android:layout_width="80dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/drillStateImage"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/completed"
                app:layout_constraintBottom_toBottomOf="@+id/boardPreview"
                app:layout_constraintEnd_toEndOf="@+id/boardPreview"
                app:layout_constraintStart_toStartOf="@+id/boardPreview"
                app:layout_constraintTop_toTopOf="@+id/boardPreview"
                app:srcCompat="@drawable/glyph_mark_check"
                app:tint="@color/white"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/white_text"
                android:ellipsize="end"
                android:id="@+id/titleTxt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_x_small"
                android:maxLines="1"
                android:fontFamily="@font/custom_bold"
                android:layout_marginStart="@dimen/margin_standard"
                app:layout_constraintBottom_toTopOf="@+id/subtitleTxt"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/boardPreview"
                app:layout_constraintTop_toTopOf="@+id/boardPreview"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/localeViewStartTextStyle"/>
            <TextView
                android:textSize="15sp"
                android:ellipsize="end"
                android:id="@+id/subtitleTxt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_x_small"
                android:maxLines="2"
                android:layout_marginStart="@dimen/margin_standard"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/boardPreview"
                app:layout_constraintTop_toBottomOf="@+id/titleTxt"
                app:layout_constraintVertical_chainStyle="spread_inside"
                style="@style/localeViewStartTextStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.chess.internal.views.card.StyledCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
