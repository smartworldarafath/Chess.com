<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tabs"
    android:paddingBottom="@dimen/margin_standard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    style="@style/TabLayout">
    <com.chess.stats.views.StatsBarChart
        android:id="@+id/statsBarChart"
        android:layout_width="match_parent"
        android:layout_height="@dimen/user_stats_bar_height"
        android:layout_marginTop="@dimen/margin_large"
        android:layout_marginStart="@dimen/margin_large"
        android:layout_marginEnd="@dimen/margin_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/avgOpponentRatingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_large"
        android:text="@string/avg_opponent_rating"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/statsBarChart"
        style="@style/SmallText.C1"/>
    <TextView
        android:textSize="26sp"
        android:id="@+id/avgOpponentRatingValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_x_small"
        android:layout_marginStart="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/avgOpponentRatingImg"
        app:layout_constraintTop_toBottomOf="@+id/avgOpponentRatingLabel"
        style="@style/Numbers"/>
    <ImageView
        android:id="@+id/avgOpponentRatingImg"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="3dp"
        android:src="@drawable/glyph_user"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/avgOpponentRatingValue"
        app:layout_constraintEnd_toStartOf="@+id/avgOpponentRatingValue"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avgOpponentRatingValue"
        app:tint="@color/white_40"/>
    <TextView
        android:id="@+id/avgOpponentWhenLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_standard"
        android:text="@string/avg_opponent_when_i"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avgOpponentRatingValue"
        style="@style/SmallText.C1"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/win"
        android:gravity="center"
        android:id="@+id/winsValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:drawablePadding="@dimen/margin_x_small"
        android:layout_marginEnd="@dimen/margin_large"
        app:drawableStartCompat="@drawable/glyph_square_fill_plus"
        app:drawableTint="@color/win"
        app:layout_constraintEnd_toStartOf="@+id/drawsValue"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avgOpponentWhenLabel"
        style="@style/Numbers"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/draw"
        android:gravity="center"
        android:id="@+id/drawsValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/margin_x_small"
        android:layout_marginEnd="@dimen/margin_large"
        app:drawableStartCompat="@drawable/glyph_square_fill_equal"
        app:drawableTint="@color/draw"
        app:layout_constraintBaseline_toBaselineOf="@+id/winsValue"
        app:layout_constraintEnd_toStartOf="@+id/lossesValue"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/winsValue"
        style="@style/Numbers"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/loss"
        android:gravity="center"
        android:id="@+id/lossesValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/margin_x_small"
        app:drawableStartCompat="@drawable/glyph_square_fill_minus"
        app:drawableTint="@color/loss"
        app:layout_constraintBaseline_toBaselineOf="@+id/winsValue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/drawsValue"
        style="@style/Numbers"/>
</androidx.constraintlayout.widget.ConstraintLayout>
