<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintWidth_max="@dimen/content_max_width">
    <ImageView
        android:id="@+id/iconFacebook"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="@dimen/margin_standard"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/margin_large"
        app:layout_constraintEnd_toStartOf="@+id/iconTwitter"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/glyph_logo_facebook"
        app:tint="@color/facebook"/>
    <TextView
        android:textSize="14sp"
        android:id="@+id/counterFacebook"
        android:paddingTop="@dimen/margin_x_standard"
        android:paddingBottom="@dimen/margin_standard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/iconFacebook"
        app:layout_constraintStart_toStartOf="@+id/iconFacebook"
        app:layout_constraintTop_toBottomOf="@+id/iconFacebook"
        style="@style/Medium.Grey"/>
    <ImageView
        android:id="@+id/iconTwitter"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toStartOf="@+id/iconYoutube"
        app:layout_constraintStart_toEndOf="@+id/iconFacebook"
        app:layout_constraintTop_toTopOf="@+id/iconFacebook"
        app:srcCompat="@drawable/glyph_logo_x"
        app:tint="@color/white"/>
    <TextView
        android:textSize="14sp"
        android:id="@+id/counterTwitter"
        android:paddingTop="@dimen/margin_x_standard"
        android:paddingBottom="@dimen/margin_standard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBaseline_toBaselineOf="@+id/counterFacebook"
        app:layout_constraintEnd_toEndOf="@+id/iconTwitter"
        app:layout_constraintStart_toStartOf="@+id/iconTwitter"
        style="@style/Medium.Grey"/>
    <ImageView
        android:id="@+id/iconYoutube"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toStartOf="@+id/iconTwitch"
        app:layout_constraintStart_toEndOf="@+id/iconTwitter"
        app:layout_constraintTop_toTopOf="@+id/iconFacebook"
        app:srcCompat="@drawable/glyph_logo_youtube"
        app:tint="@color/youtube"/>
    <TextView
        android:textSize="14sp"
        android:id="@+id/counterYoutube"
        android:paddingTop="@dimen/margin_x_standard"
        android:paddingBottom="@dimen/margin_standard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBaseline_toBaselineOf="@+id/counterFacebook"
        app:layout_constraintEnd_toEndOf="@+id/iconYoutube"
        app:layout_constraintStart_toStartOf="@+id/iconYoutube"
        style="@style/Medium.Grey"/>
    <ImageView
        android:id="@+id/iconTwitch"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toStartOf="@+id/iconInstagram"
        app:layout_constraintStart_toEndOf="@+id/iconYoutube"
        app:layout_constraintTop_toTopOf="@+id/iconFacebook"
        app:srcCompat="@drawable/glyph_logo_twitch"
        app:tint="@color/twitch"/>
    <TextView
        android:textSize="14sp"
        android:id="@+id/counterTwitch"
        android:paddingTop="@dimen/margin_x_standard"
        android:paddingBottom="@dimen/margin_standard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBaseline_toBaselineOf="@+id/counterFacebook"
        app:layout_constraintEnd_toEndOf="@+id/iconTwitch"
        app:layout_constraintStart_toStartOf="@+id/iconTwitch"
        style="@style/Medium.Grey"/>
    <ImageView
        android:id="@+id/iconInstagram"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="@dimen/margin_large"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iconTwitch"
        app:layout_constraintTop_toTopOf="@+id/iconFacebook"
        app:srcCompat="@drawable/glyph_logo_instagram"
        app:tint="@color/instagram"/>
    <TextView
        android:textSize="14sp"
        android:id="@+id/counterInstagram"
        android:paddingTop="@dimen/margin_x_standard"
        android:paddingBottom="@dimen/margin_standard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBaseline_toBaselineOf="@+id/counterFacebook"
        app:layout_constraintEnd_toEndOf="@+id/iconInstagram"
        app:layout_constraintStart_toStartOf="@+id/iconInstagram"
        style="@style/Medium.Grey"/>
</androidx.constraintlayout.widget.ConstraintLayout>
