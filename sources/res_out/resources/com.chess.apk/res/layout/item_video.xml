<?xml version="1.0" encoding="utf-8"?>
<com.chess.internal.views.card.StyledCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/articleContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/previewLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/view_video_preview"/>
        <TextView
            android:textSize="18sp"
            android:id="@+id/titleTxt"
            android:paddingTop="@dimen/margin_x_standard"
            android:paddingBottom="@dimen/margin_x_standard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3sp"
            android:textAlignment="viewStart"
            android:paddingStart="@dimen/margin_standard"
            android:paddingEnd="@dimen/margin_standard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/previewLayout"
            style="@style/Bold"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.chess.internal.views.card.StyledCardView>
