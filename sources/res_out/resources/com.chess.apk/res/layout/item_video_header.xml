<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/videoPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/view_video_preview_no_time"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/white_85"
        android:id="@+id/titleTxt"
        android:paddingTop="@dimen/margin_standard"
        android:paddingBottom="@dimen/margin_x_small"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/margin_standard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/videoPreview"
        style="@style/Bold"/>
    <include
        android:id="@+id/authorDetails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTxt"
        layout="@layout/view_author_details_with_country"/>
    <TextView
        android:textColor="@color/white_50"
        android:id="@+id/descriptionTxt"
        android:paddingTop="@dimen/half_margin_standard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/margin_standard"
        android:paddingEnd="@dimen/margin_standard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/authorDetails"/>
    <TextView
        android:textSize="@dimen/text_size_small"
        android:textColor="@color/white_50"
        android:id="@+id/copyPgnTv"
        android:padding="@dimen/half_margin_standard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:text="@string/copy_pgn"
        android:drawablePadding="@dimen/margin_x_small"
        android:layout_marginStart="@dimen/half_margin_standard"
        app:drawableStartCompat="@drawable/glyph_arrow_triangle_tray_in_bottom"
        app:drawableTint="@color/white_50"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/descriptionTxt"/>
    <ProgressBar
        android:id="@+id/progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
