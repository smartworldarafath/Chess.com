<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ot_tv_filter_layout"
    android:paddingTop="27dp"
    android:paddingBottom="27dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageButton
        android:id="@+id/tv_vl_filter_back"
        android:background="@drawable/ot_tv_round_bg"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusLeft="@+id/tv_vl_filter_back"
        android:nextFocusRight="@+id/tv_vl_filter_back"
        android:nextFocusUp="@+id/tv_vl_filter_back"
        android:nextFocusDown="@+id/ot_tv_filter_title"
        android:layout_width="@dimen/ot_tv_icon_height"
        android:layout_height="@dimen/ot_tv_icon_height"
        android:src="@drawable/ot_back_button_arrow"
        android:layout_marginStart="@dimen/ot_tv_margin_secondary"
        android:layout_marginEnd="@dimen/ot_tv_layout_margin_small"/>
    <TextView
        android:textSize="@dimen/ot_title_text_size"
        android:id="@+id/ot_tv_filter_title"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ot_margin_medium"
        android:layout_marginBottom="@dimen/ot_margin_very_small"
        android:text="Filter Vendor List"
        android:layout_marginStart="@dimen/ot_tv_margin_secondary"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ot_tv_filter_button_lyt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ot_tv_margin_secondary"
        android:layout_marginEnd="@dimen/ot_tv_margin_secondary">
        <Button
            android:layout_gravity="start"
            android:id="@+id/ot_tv_filter_apply"
            android:padding="@dimen/ot_tv_button_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:stateListAnimator="@null"/>
        <Button
            android:layout_gravity="end"
            android:id="@+id/ot_tv_filter_clear"
            android:padding="@dimen/ot_tv_button_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:stateListAnimator="@null"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/ot_subtitle_text_size"
        android:id="@+id/ot_tv_filter_type_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ot_margin_medium"
        android:layout_marginBottom="@dimen/ot_margin_very_small"
        android:text="Vendor&apos;s Type"
        android:layout_marginStart="@dimen/ot_tv_margin_secondary"
        android:accessibilityHeading="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ot_tv_filter_google_vendor_item"
        android:padding="@dimen/ot_tv_button_padding"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusUp="@+id/ot_tv_filter_apply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ot_margin_medium"
        android:layout_marginEnd="@dimen/ot_margin_medium">
        <CheckBox
            android:id="@+id/ot_tv_filter_google_vendor_cb"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/ot_tv_filter_google_vendor_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Google vendors"
            android:layout_marginStart="@dimen/ot_margin_small"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ot_tv_filter_iab_vendor_item"
        android:padding="@dimen/ot_tv_button_padding"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ot_margin_medium"
        android:layout_marginEnd="@dimen/ot_margin_medium">
        <CheckBox
            android:id="@+id/ot_tv_filter_iab_vendor_cb"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/ot_tv_filter_iab_vendor_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IAB vendors"
            android:layout_marginStart="@dimen/ot_margin_small"/>
    </LinearLayout>
    <View
        android:id="@+id/ot_tv_filter_type_divider"
        android:background="#4d4d4d"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/ot_margin_medium"
        android:layout_marginStart="@dimen/ot_tv_margin_secondary"
        android:layout_marginEnd="@dimen/ot_tv_margin_secondary"/>
    <TextView
        android:textSize="@dimen/ot_subtitle_text_size"
        android:id="@+id/ot_tv_filter_purpose_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ot_margin_medium"
        android:layout_marginBottom="@dimen/ot_margin_very_small"
        android:text="Purposes"
        android:layout_marginStart="@dimen/ot_tv_margin_secondary"
        android:accessibilityHeading="true"/>
    <androidx.recyclerview.widget.RecyclerView
        android:scrollbarSize="@dimen/ot_scrollbar_size"
        android:scrollbarAlwaysDrawVerticalTrack="true"
        android:id="@+id/ot_tv_filter_list"
        android:background="@android:color/transparent"
        android:padding="@dimen/ot_tv_button_padding"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/ot_margin_small"
        android:layout_marginBottom="@dimen/ot_margin_small"
        android:layout_marginStart="@dimen/ot_margin_medium"
        android:layout_marginEnd="18dp"/>
</LinearLayout>
