<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/chat_overlay_bg_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/text_item_normal"
            android:textColor="@color/white_80"
            android:gravity="center_vertical"
            android:id="@+id/initialItemTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/half_margin_standard"
            android:includeFontPadding="false"
            android:fontFamily="@font/custom_regular"
            android:layout_marginStart="@dimen/half_margin_standard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.chess.internal.views.DotsIndicatorView
            android:id="@+id/progressDots"
            android:layout_width="32dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/initialItemTv"
            app:layout_constraintStart_toEndOf="@+id/initialItemTv"
            app:layout_constraintTop_toTopOf="@+id/initialItemTv"/>
        <Button
            android:id="@+id/closeChatButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/no_thanks"
            app:backgroundTint="@color/control_btn_background"
            app:layout_constraintBottom_toTopOf="@+id/acceptChatButton"
            app:layout_constraintEnd_toEndOf="@+id/acceptChatButton"
            app:layout_constraintStart_toStartOf="@+id/acceptChatButton"
            app:layout_constraintTop_toBottomOf="@+id/initialItemTv"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/ButtonStyle.Slim"/>
        <com.chess.internal.views.RaisedButton
            android:id="@+id/acceptChatButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:text="@string/chat_accept"
            app:cardBackgroundColor="@color/accent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/closeChatButton"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="@dimen/text_size_normal"
            android:textColor="@color/white_65"
            android:id="@+id/preventAbuseInfoTv"
            android:padding="@dimen/margin_standard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/chat_place_be_respectful"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_max="@dimen/content_max_width_chat"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
