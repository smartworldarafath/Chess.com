<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/userImage"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="@dimen/margin_standard"
        android:contentDescription="@string/image"
        android:layout_marginStart="@dimen/margin_standard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17sp"
        android:id="@+id/userName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_standard"
        android:lineHeight="30sp"
        app:layout_constraintBottom_toTopOf="@+id/userActualName"
        app:layout_constraintStart_toEndOf="@+id/userImage"
        app:layout_constraintTop_toTopOf="@+id/userImage"
        style="@style/Bold"/>
    <com.chess.internal.views.FlagImageView
        android:id="@+id/flagImg"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/flag_content_description"
        android:layout_marginStart="@dimen/margin_small"
        app:layout_constraintBottom_toBottomOf="@+id/userName"
        app:layout_constraintStart_toEndOf="@+id/userName"
        app:layout_constraintTop_toTopOf="@+id/userName"/>
    <TextView
        android:id="@+id/userActualName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_standard"
        android:lineHeight="33sp"
        app:layout_constraintBottom_toBottomOf="@+id/userImage"
        app:layout_constraintStart_toEndOf="@+id/userImage"
        app:layout_constraintTop_toBottomOf="@+id/userName"
        style="@style/SmallText_MediumWeight"/>
    <ImageView
        android:id="@+id/compareButton"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="48dp"
        android:layout_height="32dp"
        android:contentDescription="@string/option_compare"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginEnd="@dimen/margin_x_standard"
        app:layout_constraintBottom_toTopOf="@+id/compareLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:srcCompat="@drawable/ic_compare"
        app:tint="@color/blue_light_3"/>
    <TextView
        android:textSize="12sp"
        android:id="@+id/compareLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/option_compare"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/compareButton"
        app:layout_constraintStart_toStartOf="@+id/compareButton"
        app:layout_constraintTop_toBottomOf="@+id/compareButton"
        style="@style/Medium.Grey"/>
</androidx.constraintlayout.widget.ConstraintLayout>
