<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="0.2dp">
    <ImageView
        android:id="@+id/shieldImg"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/lesson_shield_height"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/pointsTv"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.75"
        style="@style/pointsTextViewStyle"/>
    <TextView
        android:id="@+id/additionalPointTv"
        android:visibility="gone"
        android:minWidth="42dp"
        android:text="@string/lessons_plus_one"
        android:layout_marginStart="@dimen/margin_x_small"
        app:layout_constraintBottom_toBottomOf="@+id/pointsTv"
        app:layout_constraintStart_toEndOf="@+id/pointsTv"
        app:layout_constraintTop_toTopOf="@+id/pointsTv"
        style="@style/pointsTextViewStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
