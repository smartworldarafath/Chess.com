<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="24dp"
    android:animateLayoutChanges="true"
    style="@style/RoundedDialogCardView">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/x_cancel_button"
                android:background="@drawable/borderless_ripple_for_light_background"
                android:padding="@dimen/margin_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_small"
                android:contentDescription="@string/close"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/glyph_mark_cross"
                app:tint="@color/black_40"/>
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/pager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/dotLayout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_min="400dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/x_cancel_button"/>
            <com.google.inputmethod.material.tabs.TabLayout
                android:id="@+id/dotLayout"
                android:background="@color/transparent"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_marginBottom="@dimen/margin_small"
                app:layout_constraintBottom_toTopOf="@+id/submit"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/pager"
                app:layout_constraintWidth_percent="0.5"
                app:tabBackground="@drawable/dot_selector"
                app:tabIndicatorHeight="0dp"/>
            <com.chess.internal.views.RaisedButton
                android:id="@+id/submit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_standard"
                android:text="@string/upgrade_action_try_free_for_7_days"
                app:cardBackgroundColor="@color/premium"
                app:layout_constraintBottom_toTopOf="@+id/not_today"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.9"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/black_40"
                android:gravity="center"
                android:id="@+id/not_today"
                android:background="?android:attr/selectableItemBackground"
                android:padding="@dimen/margin_small"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginBottom="@dimen/margin_standard"
                android:text="@string/upgrade_action_not_today"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/submit"
                app:layout_constraintStart_toStartOf="@+id/submit"
                style="@style/Bold.SubHeader"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.cardview.widget.CardView>
