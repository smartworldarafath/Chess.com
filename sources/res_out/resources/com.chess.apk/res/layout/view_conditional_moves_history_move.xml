<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_small"
        android:textColor="@color/white"
        android:layout_gravity="center"
        android:id="@+id/move"
        android:background="@drawable/conditional_moves_history_move_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/custom_bold"
        android:paddingStart="@dimen/margin_x_small"
        android:paddingEnd="@dimen/margin_x_small"
        android:layout_marginStart="@dimen/margin_x_small"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/error_icon"
        android:background="@drawable/conditional_moves_clickable_icon_background"
        android:padding="@dimen/margin_x_small"
        android:visibility="gone"
        android:layout_width="@dimen/conditional_moves_row_height"
        android:layout_height="@dimen/conditional_moves_row_height"
        android:src="@drawable/glyph_square_fill_cross"
        app:tint="@color/red"/>
</merge>
