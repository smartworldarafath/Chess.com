<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/avatarLayout"
        android:layout_width="@dimen/avatar_img_small"
        android:layout_height="@dimen/avatar_img_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.chess.internal.views.ProfileImageView
            android:id="@+id/avatarImg"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foreground="?android:attr/selectableItemBackground"
            android:contentDescription="@string/avatar_content_description"/>
        <com.chess.palette.components.ComposeView
            android:id="@+id/avatarWithAnimatedBoard"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </FrameLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/black_40"
        android:gravity="center"
        android:id="@+id/tournamentScore"
        android:background="@color/light_grey_7"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/avatarLayout"
        app:layout_constraintEnd_toEndOf="@+id/avatarLayout"
        app:layout_constraintStart_toStartOf="@+id/avatarLayout"/>
    <com.chess.palette.components.ComposeView
        android:id="@+id/userData"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@+id/barrier"
        app:layout_constraintStart_toEndOf="@+id/avatarLayout"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/searchingTxt"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@+id/barrier"
        app:layout_constraintStart_toEndOf="@+id/avatarLayout"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/UsernameText"/>
    <com.chess.features.playerstatus.views.CapturedPiecesView
        android:id="@+id/capturedPieces"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/avatarLayout"
        app:layout_constraintTop_toBottomOf="@+id/userData"/>
    <com.chess.internal.views.CountDownTextView
        android:id="@+id/warningTimer"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:paddingEnd="2dp"
        app:autoSizeMaxTextSize="14sp"
        app:autoSizeMinTextSize="8sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toStartOf="@+id/barrier"
        app:layout_constraintStart_toStartOf="@+id/userData"
        app:layout_constraintTop_toBottomOf="@+id/userData"/>
    <TextView
        android:textColor="@color/white_40"
        android:id="@+id/extraDetailsTxt"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/userData"
        app:layout_constraintTop_toBottomOf="@+id/userData"/>
    <com.chess.palette.components.ComposeView
        android:id="@+id/ratingView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toStartOf="@+id/userData"
        app:layout_constraintTop_toBottomOf="@+id/userData"/>
    <com.chess.palette.components.ComposeView
        android:id="@+id/leagueView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@+id/ratingView"
        app:layout_constraintTop_toBottomOf="@+id/userData"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/userStatsLayout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toStartOf="@+id/userData"
        app:layout_constraintTop_toBottomOf="@+id/userData">
        <ImageView
            android:id="@+id/leagueIcon"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/ButtonTextAppearance"
            android:textSize="8sp"
            android:id="@+id/leagueRank"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="@+id/leagueIcon"
            app:layout_constraintStart_toStartOf="@+id/leagueIcon"
            app:layout_constraintTop_toTopOf="@+id/leagueIcon"
            style="@style/BlackWeight"/>
        <ImageView
            android:id="@+id/puzzleLevelTierIcon"
            android:visibility="gone"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:layout_marginStart="3dp"
            app:layout_constraintStart_toEndOf="@+id/leagueIcon"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/ButtonTextAppearance"
            android:textSize="8sp"
            android:id="@+id/puzzleLevel"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="@+id/puzzleLevelTierIcon"
            app:layout_constraintEnd_toEndOf="@+id/puzzleLevelTierIcon"
            app:layout_constraintStart_toStartOf="@+id/puzzleLevelTierIcon"
            app:layout_constraintTop_toTopOf="@+id/puzzleLevelTierIcon"
            style="@style/BlackWeight"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/drawOffer"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/game_avatar_padding_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/timeView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/view_draw_confirmation"/>
    <com.chess.features.playerstatus.views.ClockView
        android:id="@+id/timeView"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/avatarLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avatarLayout"
        app:layout_constraintWidth_min="104dp"/>
    <com.chess.features.playerstatus.views.UserStateView
        android:id="@+id/userStateView"
        android:focusable="true"
        android:visibility="invisible"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/avatarLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avatarLayout"
        app:layout_constraintWidth_min="96dp"/>
    <com.chess.chat.sharedviews.ChatBubbleView
        android:id="@+id/chatBubble"
        android:visibility="invisible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatarLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/avatarLayout"
        app:layout_constraintTop_toTopOf="@+id/avatarLayout"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="1dp"
        app:barrierDirection="start"
        app:constraint_referenced_ids="timeView,userStateView"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="warningTimer,userData,avatarLayout"/>
</merge>
