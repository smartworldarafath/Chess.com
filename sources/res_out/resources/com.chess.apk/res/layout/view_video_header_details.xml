<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="18sp"
        android:id="@+id/titleTxt"
        android:paddingTop="@dimen/margin_x_standard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3sp"
        android:textAlignment="viewStart"
        android:paddingStart="@dimen/margin_standard"
        android:paddingEnd="@dimen/margin_standard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Bold"/>
    <include
        android:id="@+id/authorDetailsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTxt"
        layout="@layout/view_author_details"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/descriptionTxt"
        android:paddingTop="@dimen/margin_x_small"
        android:paddingBottom="@dimen/margin_standard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="@integer/article_content_max_lines"
        android:lineSpacingExtra="2sp"
        android:textAlignment="viewStart"
        android:paddingStart="@dimen/margin_standard"
        android:paddingEnd="@dimen/margin_standard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/authorDetailsContainer"
        app:layout_constraintVertical_bias="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
