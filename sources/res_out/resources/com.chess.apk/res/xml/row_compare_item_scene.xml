            android:layout_height="24dp"
            app:layout_constraintBottom_toTopOf="@+id/type"
            app:layout_constraintEnd_toEndOf="@+id/type"
            app:layout_constraintStart_toStartOf="@+id/type"
            app:layout_constraintTop_toTopOf="@+id/primarySpace"
            app:layout_constraintVertical_chainStyle="packed"/>
        <Constraint
            android:id="@+id/opponent_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/primarySpace"
            app:layout_constraintEnd_toEndOf="@+id/primarySpace"
            app:layout_constraintHorizontal_bias="0.77"
            app:layout_constraintStart_toStartOf="@+id/primarySpace"
            app:layout_constraintTop_toTopOf="@+id/primarySpace"/>
        <Constraint
            android:id="@+id/opponent_score_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/primarySpace"
            app:layout_constraintEnd_toEndOf="@+id/primarySpace"
            app:layout_constraintHorizontal_bias="0.95"
            app:layout_constraintStart_toStartOf="@+id/primarySpace"
            app:layout_constraintTop_toTopOf="@+id/primarySpace"/>
        <Constraint
            android:id="@+id/user_games"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/games_label"
            app:layout_constraintEnd_toEndOf="@+id/user_rating"
            app:layout_constraintStart_toStartOf="@+id/user_rating"
            app:layout_constraintTop_toTopOf="@+id/games_label"/>
        <Constraint
            android:id="@+id/user_rank"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/rank_label"
            app:layout_constraintEnd_toEndOf="@+id/user_record"
            app:layout_constraintStart_toStartOf="@+id/user_record"
            app:layout_constraintTop_toTopOf="@+id/rank_label"/>
        <Constraint
            android:id="@+id/user_record"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/record_label"
            app:layout_constraintEnd_toEndOf="@+id/user_rating"
            app:layout_constraintStart_toStartOf="@+id/user_rating"
            app:layout_constraintTop_toTopOf="@+id/record_label"/>
        <Constraint
            android:id="@+id/games_label"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:layout_constraintEnd_toEndOf="@+id/icon"
            app:layout_constraintStart_toStartOf="@+id/icon"
            app:layout_constraintTop_toBottomOf="@+id/type"/>
        <Constraint
            android:id="@+id/record_label"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="@+id/icon"
            app:layout_constraintStart_toStartOf="@+id/icon"
            app:layout_constraintTop_toBottomOf="@+id/games_label"/>
        <Constraint
