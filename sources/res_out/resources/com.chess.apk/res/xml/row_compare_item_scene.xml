            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/record_label"
            app:layout_constraintEnd_toEndOf="@+id/opponent_rating"
            app:layout_constraintStart_toStartOf="@+id/opponent_rating"
            app:layout_constraintTop_toTopOf="@+id/record_label"/>
        <Constraint
            android:id="@+id/opponent_rank"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/rank_label"
            app:layout_constraintEnd_toEndOf="@+id/opponent_rating"
            app:layout_constraintStart_toStartOf="@+id/opponent_rating"
            app:layout_constraintTop_toTopOf="@+id/rank_label"/>
