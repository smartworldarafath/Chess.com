<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <Transition
        app:constraintSetEnd="@+id/end"
        app:constraintSetStart="@+id/start"
        app:duration="200"/>
    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@+id/primarySpace"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Constraint
            android:gravity="center"
            android:id="@+id/user_score_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="36dp"
            app:layout_constraintBottom_toBottomOf="@+id/primarySpace"
            app:layout_constraintEnd_toEndOf="@+id/primarySpace"
            app:layout_constraintHorizontal_bias="0.05"
            app:layout_constraintStart_toStartOf="@+id/primarySpace"
            app:layout_constraintTop_toTopOf="@+id/primarySpace"/>
        <Constraint
            android:gravity="center"
            android:id="@+id/user_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="52dp"
            app:layout_constraintBottom_toBottomOf="@+id/primarySpace"
            app:layout_constraintEnd_toEndOf="@+id/primarySpace"
            app:layout_constraintHorizontal_bias="0.23"
            app:layout_constraintStart_toStartOf="@+id/primarySpace"
            app:layout_constraintTop_toTopOf="@+id/primarySpace"/>
        <Constraint
            android:id="@+id/type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/primarySpace"
            app:layout_constraintEnd_toEndOf="@+id/primarySpace"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="@+id/primarySpace"
            app:layout_constraintTop_toBottomOf="@+id/icon"/>
        <Constraint
            android:id="@+id/icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toTopOf="@+id/type"
            app:layout_constraintEnd_toEndOf="@+id/type"
            app:layout_constraintStart_toStartOf="@+id/type"
            app:layout_constraintTop_toTopOf="@+id/primarySpace"
            app:layout_constraintVertical_chainStyle="packed"/>
        <Constraint
            android:gravity="center"
            android:id="@+id/opponent_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="52dp"
            app:layout_constraintBottom_toBottomOf="@+id/primarySpace"
            app:layout_constraintEnd_toEndOf="@+id/primarySpace"
            app:layout_constraintHorizontal_bias="0.77"
            app:layout_constraintStart_toStartOf="@+id/primarySpace"
            app:layout_constraintTop_toTopOf="@+id/primarySpace"/>
