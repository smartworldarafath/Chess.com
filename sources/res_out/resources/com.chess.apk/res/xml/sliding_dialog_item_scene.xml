<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:motion="http://schemas.android.com/apk/res-auto">
    <Transition
        motion:constraintSetEnd="@+id/end"
        motion:constraintSetStart="@+id/start"
        motion:duration="1000">
        <KeyFrameSet/>
    </Transition>
    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@+id/image"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:alpha="0.1"
            motion:layout_constraintBottom_toBottomOf="@+id/icon_holder"
            motion:layout_constraintEnd_toEndOf="@+id/icon_holder"
            motion:layout_constraintStart_toStartOf="@+id/icon_holder"
            motion:layout_constraintTop_toTopOf="@+id/icon_holder"/>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/end"/>
</MotionScene>
